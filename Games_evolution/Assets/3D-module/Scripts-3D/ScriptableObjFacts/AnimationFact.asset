  m_Script: {fileID: 11500000, guid: 60a57df3f5377114b900b13deae2fd8e, type: 3}
  m_Name: AnimationFact
  m_EditorClassIdentifier: Assembly-CSharp::Article
  moduleIndex: 2
  articleId: mechanics_animation
  title: "\u0410\u043D\u0438\u043C\u0430\u0446\u0438\u0438 \u0432 3D"
  fullText: "\u0412 \u0434\u0432\u0443\u0445\u043C\u0435\u0440\u043D\u044B\u0445
    \u0438\u0433\u0440\u0430\u0445 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F
    \u0431\u044B\u043B\u0430 \u043F\u043E\u043A\u0430\u0434\u0440\u043E\u0432\u043E\u0439:
    \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438 \u0440\u0438\u0441\u043E\u0432\u0430\u043B\u0438
    \u043A\u0430\u0436\u0434\u044B\u0439 \u043A\u0430\u0434\u0440 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E, \u043A\u0430\u043A \u0432 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0438\u043A\u0430\u0446\u0438\u0438.
    \u042D\u0442\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u043D\u043E \u0442\u0440\u0443\u0434\u043E\u0451\u043C\u043A\u043E
    \u0438 \u043D\u0435\u0433\u0438\u0431\u043A\u043E \u2014 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
    \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044E \u0438\u043B\u0438 \u0441\u043C\u0435\u0448\u0430\u0442\u044C
    \u0434\u0432\u0435 \u0432\u043C\u0435\u0441\u0442\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u0412 3D \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u044B\u0439
    \u043F\u043E\u0434\u0445\u043E\u0434: \u0441\u043A\u0435\u043B\u0435\u0442\u043D\u0430\u044F
    \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F. \u0412\u043D\u0443\u0442\u0440\u044C
    \u043C\u043E\u0434\u0435\u043B\u0438 \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
    \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u043A\u0435\u043B\u0435\u0442
    \u2014 \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u044F \xAB\u043A\u043E\u0441\u0442\u0435\u0439\xBB,
    \u043A\u0430\u0436\u0434\u0430\u044F \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C \u043C\u043E\u0434\u0435\u043B\u0438. \u0410\u043D\u0438\u043C\u0430\u0442\u043E\u0440
    \u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u043A\u043E\u0441\u0442\u0438, \u0430
    \u043C\u043E\u0434\u0435\u043B\u044C \u0434\u0435\u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E.\r\n\r\n\u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430
    \u043E\u0433\u0440\u043E\u043C\u043D\u044B: \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438
    \u043C\u043E\u0436\u043D\u043E \u043F\u043B\u0430\u0432\u043D\u043E \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C
    (\u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u043C\u043E\u0436\u0435\u0442
    \u0438\u0434\u0442\u0438 \u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u043C\u0430\u0445\u0430\u0442\u044C \u0440\u0443\u043A\u043E\u0439), \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C
    \u043A \u0440\u0430\u0437\u043D\u044B\u043C \u043C\u043E\u0434\u0435\u043B\u044F\u043C
    \u043E\u0434\u0438\u043D \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0441\u043A\u0435\u043B\u0435\u0442,
    \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044E (\u0440\u0430\u0437\u0432\u0435\u0432\u0430\u044E\u0449\u0438\u0435\u0441\u044F
    \u0432\u043E\u043B\u043E\u0441\u044B, \u0442\u0440\u044F\u0441\u0443\u0449\u0438\u0435\u0441\u044F
    \u0447\u0430\u0441\u0442\u0438 \u0442\u0435\u043B\u0430). \u0421\u043A\u0435\u043B\u0435\u0442\u043D\u0430\u044F
    \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044F \u0441\u0442\u0430\u043B\u0430
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043E\u043C \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u0438
    \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u043F\u043E\u0432\u0441\u0435\u043C\u0435\u0441\u0442\u043D\u043E \u2014 \u043E\u0442
    \u0438\u043D\u0434\u0438-\u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432 \u0434\u043E
    \u0431\u043B\u043E\u043A\u0431\u0430\u0441\u0442\u0435\u0440\u043E\u0432. \u0411\u0435\u0437
    \u043D\u0435\u0451 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
    \u0438\u0433\u0440\u044B \u0441 \u0438\u0445 \u043F\u043B\u0430\u0432\u043D\u044B\u043C\u0438
    \u0438 \u0436\u0438\u0432\u044B\u043C\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u043C\u0438
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439."
  shortAnnotation:
  - "\u041F\u043E\u043A\u0430 \u0442\u044B \u043F\u0440\u044B\u0433\u0430\u0435\u0448\u044C,
    \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C \u043A \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u043C
    \u041F\u0438\u043A\u0441\u0435\u043B\u0438. \u0420\u0430\u043D\u044C\u0448\u0435
    \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044E \u0440\u0438\u0441\u043E\u0432\u0430\u043B\u0438
    \u043A\u0430\u0434\u0440 \u0437\u0430 \u043A\u0430\u0434\u0440\u043E\u043C, \u043A\u0430\u043A
    \u0432 \u043C\u0443\u043B\u044C\u0442\u0444\u0438\u043B\u044C\u043C\u0430\u0445.
    \u0422\u0430\u043A \u0442\u044B \u0434\u0432\u0438\u0433\u0430\u043B\u0430\u0441\u044C
    \u0432 2D!"
  - "\u0410 \u0432 3D \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u0441\u043A\u0435\u043B\u0435\u0442\u043D\u0443\u044E \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u044E: 
    \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u043E\u0441\u0442\u0438
    \u0432\u043D\u0443\u0442\u0440\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0432\u0438\u0433\u0430\u044E\u0442
    \u043C\u043E\u0434\u0435\u043B\u044C."
  - "\u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438
    \u0431\u044B\u0442\u044C \u043F\u043B\u0430\u0432\u043D\u043E\u0439, \u0438 \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0439,
    \u0430 \u0435\u0449\u0435 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438 \u0432\u0430\u0436\u043D\u044B
    \u0434\u043B\u044F \u0432\u043E\u0432\u043B\u0435\u0447\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0441\u043E\u043F\u0440\u0435\u0436\u0438\u0432\u0430\u043D\u0438\u044F."
  tutorialMessages: []
  timedHints: []
