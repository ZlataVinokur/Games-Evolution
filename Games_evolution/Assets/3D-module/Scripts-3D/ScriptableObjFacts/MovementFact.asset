  moduleIndex: 2
  articleId: mechanics_movement
  title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u0432 3D"
  fullText: "\u041F\u0435\u0440\u0435\u0445\u043E\u0434 \u043E\u0442 2D \u043A 3D
    \u0432 \u0438\u0433\u0440\u0430\u0445 \u0441\u0442\u0430\u043B, \u043F\u043E\u0436\u0430\u043B\u0443\u0439,
    \u0441\u0430\u043C\u044B\u043C \u0442\u0435\u043A\u0442\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0441\u0434\u0432\u0438\u0433\u043E\u043C \u0437\u0430 \u0432\u0441\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E
    \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u0438. \u0412 \u0434\u0432\u0443\u0445\u043C\u0435\u0440\u043D\u044B\u0445
    \u0438\u0433\u0440\u0430\u0445 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436
    \u0431\u044B\u043B \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u044C\u044E:
    \u0432\u043B\u0435\u0432\u043E-\u0432\u043F\u0440\u0430\u0432\u043E, \u0438\u043D\u043E\u0433\u0434\u0430
    \u0432\u0432\u0435\u0440\u0445-\u0432\u043D\u0438\u0437 (\u043A\u0430\u043A \u0432
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u0430\u0445), \u043D\u043E
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445
    \u043F\u043B\u043E\u0441\u043A\u043E\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438.
    \u0421 \u043F\u0440\u0438\u0445\u043E\u0434\u043E\u043C \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u043E\u0439
    \u0433\u0440\u0430\u0444\u0438\u043A\u0438 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
    1990-\u0445 \u2014 \u043F\u0438\u043E\u043D\u0435\u0440\u0430\u043C\u0438 \u0431\u044B\u043B\u0438
    \u0442\u0430\u043A\u0438\u0435 \u0438\u0433\u0440\u044B, \u043A\u0430\u043A Wolfenstein
    3D (1992) \u0438 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E Doom (1993)
    \u2014 \u0438\u0433\u0440\u043E\u043A \u0432\u043F\u0435\u0440\u0432\u044B\u0435
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0432\u043E\u0431\u043E\u0434\u0443
    \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043F\u043E
    \u0442\u0440\u0451\u043C \u043E\u0441\u044F\u043C \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442.\r\n\r\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C
    \u043F\u0440\u043E\u0440\u044B\u0432\u043E\u043C \u0441\u0442\u0430\u043B\u0430
    \u0438\u0433\u0440\u0430 Quake (1996), \u0433\u0434\u0435 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
    \u0441\u043E\u0447\u0435\u0442\u0430\u043B\u043E\u0441\u044C \u0441 \u0432\u0438\u0434\u043E\u043C
    \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430
    \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E
    \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432 \u043B\u044E\u0431\u0443\u044E
    \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u042D\u0442\u043E \u043F\u043E\u0440\u043E\u0434\u0438\u043B\u043E
    \u0436\u0430\u043D\u0440\u044B, \u043D\u0435\u043C\u044B\u0441\u043B\u0438\u043C\u044B\u0435
    \u0432 2D: immersive sim (System Shock, Deus Ex), \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u044B\u0435
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u044B (Super Mario
    64), \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u043C\u0438\u0440\u044B.
    \u0421\u0432\u043E\u0431\u043E\u0434\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0433\u0435\u0439\u043C\u043F\u043B\u0435\u0439, \u043D\u043E \u0438 \u043D\u0430\u0440\u0440\u0430\u0442\u0438\u0432:
    \u0438\u0433\u0440\u043E\u043A \u043C\u043E\u0433 \u0441\u0430\u043C \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C,
    \u043A\u0443\u0434\u0430 \u043F\u043E\u0439\u0442\u0438 \u0438 \u0447\u0442\u043E
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u044D\u0442\u043E \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C,
    \u043D\u043E \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 90-\u0445
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u043E
    \u043E\u0431\u043E\u0439\u0442\u0438 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0435
    \u0441\u043E \u0432\u0441\u0435\u0445 \u0441\u0442\u043E\u0440\u043E\u043D \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C
    \u043A\u0430\u043A \u0447\u0443\u0434\u043E."
