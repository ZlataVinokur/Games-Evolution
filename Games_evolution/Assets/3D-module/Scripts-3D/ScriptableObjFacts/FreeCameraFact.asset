  moduleIndex: 2
  articleId: mechanics_free-camera
  title: "\u041A\u0430\u043C\u0435\u0440\u0430 \u0432 3D"
  fullText: "\u0412 2D \u043A\u0430\u043C\u0435\u0440\u0430 \u043E\u0431\u044B\u0447\u043D\u043E
    \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430 \u0437\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C
    \u0441\u0442\u0440\u043E\u0433\u043E \u0441\u0431\u043E\u043A\u0443 \u0438\u043B\u0438
    \u0441\u0432\u0435\u0440\u0445\u0443. \u0412 3D \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043A\u0430\u043C\u0435\u0440\u043E\u0439 \u0441\u0442\u0430\u043B\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u043E\u0439. \u0418\u0433\u0440\u043E\u043A
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0432\u0440\u0430\u0449\u0430\u0442\u044C \u043E\u0431\u0437\u043E\u0440, \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0442\u044C
    \u0438 \u043E\u0442\u0434\u0430\u043B\u044F\u0442\u044C \u0435\u0433\u043E \u2014
    \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \xAB\u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0432 \u0440\u0443\u043A\u0430\u0445\xBB \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0439
    \u0433\u043B\u0430\u0437. \u041F\u0435\u0440\u0432\u044B\u0435 \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u044B\u0435
    \u0438\u0433\u0440\u044B \u0447\u0430\u0441\u0442\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438
    \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0440\u0430\u043A\u0443\u0440\u0441\u044B (\u043A\u0430\u043A \u0432 \u0440\u0430\u043D\u043D\u0438\u0445
    Resident Evil), \u043D\u043E \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F \u043A\u0430\u043C\u0435\u0440\u0430
    \u0441\u0442\u0430\u043B\u0430 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043E\u043C.\r\n\r\n\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u044F\u0440\u043A\u043E \u044D\u0442\u043E \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u043E\u0441\u044C
    \u0432 \u0438\u0433\u0440\u0430\u0445 \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
    \u043B\u0438\u0446\u0430: Super Mario 64 (1996) \u0441\u0434\u0435\u043B\u0430\u043B\u0430
    \u043A\u0430\u043C\u0435\u0440\u0443 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u043C
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C, \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u044B\u043C
    \u0438\u0433\u0440\u043E\u043A\u043E\u043C, \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u044B\u0435
    \u043C\u0438\u0440\u044B \u0431\u0435\u0437 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439
    \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0442\u043E\u0447\u0435\u043A \u043E\u0431\u0437\u043E\u0440\u0430. \u0412 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445
    \u0438\u0433\u0440\u0430\u0445 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F
    \u043A\u0430\u043C\u0435\u0440\u0430 \u2014 \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E, \u0430 \u0441\u043F\u043E\u0441\u043E\u0431
    \u043F\u043E\u0432\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F:
    \u0432 The Legend of Zelda: Breath of the Wild \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
    \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438
    \u0441 \u0432\u0435\u0440\u0448\u0438\u043D\u044B, \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u044F
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442, \u0430 \u0432 \u0445\u043E\u0440\u0440\u043E\u0440\u0430\u0445
    \u2014 \u0432 \u0443\u0436\u0430\u0441\u0435 \u043E\u0433\u043B\u044F\u043D\u0443\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0437\u0432\u0443\u043A \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439."
