  m_Script: {fileID: 11500000, guid: 60a57df3f5377114b900b13deae2fd8e, type: 3}
  m_Name: PlatformerFact
  m_EditorClassIdentifier: Assembly-CSharp::Article
  moduleIndex: 2
  articleId: mechanics_platformer
  title: "\u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u044B \u0432
    3D"
  fullText: "\u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440 \u043A\u0430\u043A
    \u0436\u0430\u043D\u0440 \u0440\u043E\u0434\u0438\u043B\u0441\u044F \u0432 \u044D\u043F\u043E\u0445\u0443
    2D \u2014 \u0438\u0433\u0440\u044B \u0432\u0440\u043E\u0434\u0435 Donkey Kong
    (1981) \u0438 Super Mario Bros. (1985) \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438
    \u0435\u0433\u043E \u043A\u0430\u043D\u043E\u043D\u044B: \u043F\u0440\u044B\u0436\u043A\u0438
    \u043F\u043E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u043C, \u0438\u0437\u0431\u0435\u0433\u0430\u043D\u0438\u0435
    \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0439, \u0441\u0431\u043E\u0440
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432. \u0421 \u043F\u0440\u0438\u0445\u043E\u0434\u043E\u043C
    3D \u0436\u0430\u043D\u0440 \u043F\u0435\u0440\u0435\u0436\u0438\u043B \u043A\u0440\u0438\u0437\u0438\u0441
    \u0438 \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435. Super
    Mario 64 (1996) \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B\u0430 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u044E,
    \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u044F \u0444\u043E\u0440\u043C\u0443\u043B\u0443
    \u0432 \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E.
    \u0412\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
    \u0432 3D \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0438\u043D\u0433
    \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0441\u043B\u043E\u0436\u043D\u0435\u0435:
    \u0438\u0433\u0440\u043E\u043A\u0443 \u0442\u0440\u0443\u0434\u043D\u043E \u043E\u0446\u0435\u043D\u0438\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0438 \u0433\u043B\u0443\u0431\u0438\u043D\u0443
    \u043F\u0440\u044B\u0436\u043A\u0430, \u043B\u0435\u0433\u043A\u043E \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0443\u0442\u044C\u0441\u044F.\r\n\r\n\u0414\u0438\u0437\u0430\u0439\u043D\u0435\u0440\u0430\u043C
    \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0440\u0435\u0448\u0430\u0442\u044C
    \u044D\u0442\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B: \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
    \xAB\u043C\u044F\u0433\u043A\u0438\u0435\xBB \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u044F
    (\u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430
    \u0443 \u043A\u0440\u0430\u044F \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B),
    \u0442\u0435\u043D\u044C \u043F\u043E\u0434 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C
    \u043A\u0430\u043A \u043C\u0430\u0440\u043A\u0435\u0440 \u0442\u043E\u0447\u043A\u0438
    \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u044F, \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u0430\u043C\u0435\u0440\u0430, \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0449\u0430\u044F
    \u0440\u0430\u043A\u0443\u0440\u0441. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u044B\u0435 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u044B
    \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u044E\u0442 \u0432 \u0441\u0430\u043C\u044B\u0445
    \u0440\u0430\u0437\u043D\u044B\u0445 \u0444\u043E\u0440\u043C\u0430\u0445: \u043E\u0442
    \u043B\u0438\u043D\u0435\u0439\u043D\u044B\u0445 (Crash Bandicoot N. Sane Trilogy)
    \u0434\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445 \u043C\u0438\u0440\u043E\u0432
    (Super Mario Odyssey). \u0410 \u0441 \u043F\u0440\u0438\u0445\u043E\u0434\u043E\u043C
    VR \u0436\u0430\u043D\u0440 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043D\u043E\u0432\u043E\u0435
    \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u2014 \u0442\u0435\u043F\u0435\u0440\u044C
    \u0438\u0433\u0440\u043E\u043A \u043C\u043E\u0436\u0435\u0442 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
    \u0441\u0432\u043E\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
  shortAnnotation:
  - "\u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u044B \u0440\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0435\u0449\u0451 \u0432 2D, \u043D\u043E \u0432 3D \u0432\u0441\u0451 \u0443\u0441\u043B\u043E\u0436\u043D\u0438\u043B\u043E\u0441\u044C:
    \u043D\u0443\u0436\u043D\u043E \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0441\u043E\u0442\u0443
    \u0438 \u0434\u043B\u0438\u043D\u0443 \u043F\u0440\u044B\u0436\u043A\u0430, \u043D\u043E
    \u0438 \u0433\u043B\u0443\u0431\u0438\u043D\u0443"
  - "\u041B\u0435\u0433\u043A\u043E \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0443\u0442\u044C\u0441\u044F,
    \u043D\u0435\u0434\u043E\u043B\u0435\u0442\u0435\u0442\u044C \u0438\u043B\u0438
    \u0443\u043F\u0430\u0441\u0442\u044C. \u0417\u0434\u0435\u0441\u044C \u0432\u0430\u0436\u0435\u043D
    \u0433\u043B\u0430\u0437\u043E\u043C\u0435\u0440 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
    \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u0432\u0435\u0440\u0445\u0430!"
  tutorialMessages: []
  timedHints: []
