  m_Script: {fileID: 11500000, guid: 60a57df3f5377114b900b13deae2fd8e, type: 3}
  m_Name: InteractionFact
  m_EditorClassIdentifier: Assembly-CSharp::Article
  moduleIndex: 2
  articleId: mechanics_interaction
  title: "\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432 \u0432 3D"
  fullText: "\u0414\u043E \u044D\u043F\u043E\u0445\u0438 3D \u0438\u0433\u0440\u043E\u0432\u043E\u0435
    \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
    \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0441\u0442\u0430\u0442\u0438\u0447\u043D\u044B\u043C
    \u0444\u043E\u043D\u043E\u043C. \u0412 \u0434\u0432\u0443\u0445\u043C\u0435\u0440\u043D\u044B\u0445
    \u0438\u0433\u0440\u0430\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u0440\u0435\u0434\u043A\u043E
    \u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043B\u0438 \u043D\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438\u0433\u0440\u043E\u043A\u0430
    \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438 \u0441\u0442\u0440\u043E\u0433\u043E
    \u0437\u0430\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0435\u0432. \u0421 \u043F\u0440\u0438\u0445\u043E\u0434\u043E\u043C
    \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u044B\u0445 \u043C\u0438\u0440\u043E\u0432
    \u0432\u0441\u0451 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C:
    \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043E\u0431\u044A\u0435\u043A\u0442\u044B,
    \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \u043C\u043E\u0436\u043D\u043E
    \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438 \u2014 \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0442\u044C,
    \u0431\u0440\u043E\u0441\u0430\u0442\u044C, \u0440\u043E\u043D\u044F\u0442\u044C,
    \u0441\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u0442\u044C, \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0442\u044C.\r\n\r\n\u041E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043F\u0438\u043E\u043D\u0435\u0440\u043E\u0432 \u0437\u0434\u0435\u0441\u044C
    \u0441\u0442\u0430\u043B\u0430 Half-Life 2 (2004) \u0441 \u0435\u0451 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0439
    \u0433\u0440\u0430\u0432\u0438\u043F\u0443\u0448\u043A\u043E\u0439, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0432\u0448\u0435\u0439
    \u0445\u0432\u0430\u0442\u0430\u0442\u044C \u0438 \u0448\u0432\u044B\u0440\u044F\u0442\u044C
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043B\u044E\u0431\u044B\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B. \u042D\u0442\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u043E
    \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0438\u0437 \u0434\u0435\u043A\u043E\u0440\u0430\u0446\u0438\u0438
    \u0432 \u0430\u0440\u0441\u0435\u043D\u0430\u043B \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043C\u0438\u0440\u044B \u0441\u0442\u0430\u043B\u0438 \u043D\u043E\u0440\u043C\u043E\u0439:
    \u0432 The Legend of Zelda: Breath of the Wild \u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u0434\u0436\u0435\u0447\u044C \u0442\u0440\u0430\u0432\u0443, \u0440\u0430\u0437\u0440\u0443\u0431\u0438\u0442\u044C
    \u0434\u0435\u0440\u0435\u0432\u043E, \u0441\u043E\u0437\u0434\u0430\u0442\u044C
    \u043F\u043E\u0442\u043E\u043A \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u2014
    \u0432\u0441\u0451 \u044D\u0442\u043E \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430
    \u0433\u0435\u0439\u043C\u043F\u043B\u0435\u0439. 3D \u0441\u0434\u0435\u043B\u0430\u043B\u043E
    \u043C\u0438\u0440 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u043C,
    \u0430 \u0436\u0438\u0432\u044B\u043C \u0438 \u043E\u0442\u0437\u044B\u0432\u0447\u0438\u0432\u044B\u043C."
  shortAnnotation:
  - "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0432\u0435\u0441\u044B \u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u044E\u0442\u0441\u044F!
    \u0421\u043C\u043E\u0442\u0440\u0438, \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F
    \u043F\u043E\u0442\u043E\u0439\u043D\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C.
    \u0427\u0442\u043E \u0436\u0435 \u043E\u043D \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442?"
  - "\u041C\u0435\u0436\u0434\u0443 \u043F\u0440\u043E\u0447\u0438\u043C, \u0442\u044B
    \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0430\u0441\u044C
    \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E 3D \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435
    \u2014 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430.
    \u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u043C\u043E\u0436\u043D\u043E
    \u0442\u0440\u043E\u0433\u0430\u0442\u044C, \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C,
    \u0440\u043E\u043D\u044F\u0442\u044C. \u041C\u0438\u0440 \u0441\u0442\u0430\u043B
    \u043D\u0435 \u0444\u043E\u043D\u043E\u043C, \u0430 \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u044C\u044E \u0438\u0433\u0440\u044B."
  tutorialMessages: []
  timedHints: []
