  shortAnnotation:
  - "\u042D\u0442\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430 \u043E\u0447\u0435\u043D\u044C
    \u0432\u044B\u0441\u043E\u043A\u0430\u044F, \u0438\u0437 \u043D\u0435\u0435 \u043C\u043E\u0436\u043D\u043E
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439
    \u043C\u043E\u0441\u0442\u0438 \u043A \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u043C."
  - "\u0412\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043D\u0430 \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435
    \u0436\u0443\u0442\u043A\u043E \u0442\u044F\u0436\u0435\u043B\u0430\u044F...
    \u041D\u0443\u0436\u043D\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F,
    \u0442\u0443\u0442 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
    \u0447\u0442\u043E-\u0442\u043E, \u0447\u0442\u043E \u043D\u0430\u043C \u043F\u043E\u043C\u043E\u0436\u0435\u0442."
