  m_Script: {fileID: 11500000, guid: 60a57df3f5377114b900b13deae2fd8e, type: 3}
  m_Name: TPCameraFact
  m_EditorClassIdentifier: Assembly-CSharp::Article
  moduleIndex: 2
  articleId: mechanics_TPcamera
  title: "\u041A\u0430\u043C\u0435\u0440\u0430 \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
    \u043B\u0438\u0446\u0430"
  fullText: "\u0412\u044B\u0431\u043E\u0440 \u043C\u0435\u0436\u0434\u0443 \u0432\u0438\u0434\u043E\u043C
    \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0438 \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
    \u043B\u0438\u0446\u0430 \u2014 \u043E\u0434\u043D\u043E \u0438\u0437 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u0440\u0435\u0448\u0435\u043D\u0438\u0439 \u043F\u0440\u0438 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438
    \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u043E\u0439 \u0438\u0433\u0440\u044B.
    \u0412\u0438\u0434 \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430
    (First Person) \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u0435\u0442 \u0438\u0433\u0440\u043E\u043A\u0430
    \u0432 \u043C\u0438\u0440 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E, \u0434\u0435\u043B\u0430\u044F
    \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430.
    \u042D\u0442\u043E \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
    \u044D\u0444\u0444\u0435\u043A\u0442 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F
    \u0438 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
    \u0434\u043B\u044F \u0448\u0443\u0442\u0435\u0440\u043E\u0432 (Doom, Call of
    Duty), \u0445\u043E\u0440\u0440\u043E\u0440\u043E\u0432 (Amnesia, Outlast) \u0438
    immersive sim (Deus Ex). \u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u043A
    \u2014 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439
    \u043E\u0431\u0437\u043E\u0440: \u0432\u044B \u043D\u0435 \u0432\u0438\u0434\u0438\u0442\u0435,
    \u0447\u0442\u043E \u0443 \u0432\u0430\u0441 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.\r\n\r\n\u0412\u0438\u0434
    \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043B\u0438\u0446\u0430
    (Third Person) \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430
    \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0434\u0430\u0432\u0430\u044F
    \u043B\u0443\u0447\u0448\u0438\u0439 \u043E\u0431\u0437\u043E\u0440 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430
    \u0432\u043E\u043A\u0440\u0443\u0433. \u042D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
    \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0434\u043B\u044F \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u043E\u0432
    (Super Mario Odyssey), \u044D\u043A\u0448\u0435\u043D\u043E\u0432 (Dark Souls),
    \u0444\u0430\u0439\u0442\u0438\u043D\u0433\u043E\u0432 \u0438 \u0438\u0433\u0440
    \u0441 \u0430\u043A\u0440\u043E\u0431\u0430\u0442\u0438\u043A\u043E\u0439. \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0442
    \u0433\u0438\u0431\u0440\u0438\u0434\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B:
    \u043C\u043D\u043E\u0433\u0438\u0435 \u0438\u0433\u0440\u044B \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
    \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F
    \u043C\u0435\u0436\u0434\u0443 \u0440\u0435\u0436\u0438\u043C\u0430\u043C\u0438
    (Skyrim, GTA V), \u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0438\u0437\u043E\u0431\u0440\u0435\u043B\u0438 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u044B\u0439
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u2014 \u0432\u0438\u0434 \xAB\u0438\u0437-\u0437\u0430
    \u043F\u043B\u0435\u0447\u0430\xBB (Resident Evil 4), \u0441\u0442\u0430\u0432\u0448\u0438\u0439
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043E\u043C \u0434\u043B\u044F
    \u0448\u0443\u0442\u0435\u0440\u043E\u0432 \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
    \u043B\u0438\u0446\u0430."
  shortAnnotation:
  - "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440
    \u2014 \u0441\u0435\u0439\u0447\u0430\u0441 \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
    \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C. \u041D\u0430\u0436\u043C\u0438
    [R], \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043D\u0430 \u0441\u0435\u0431\u044F \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B."
  - "\u0412\u0438\u0434 \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
    \u043B\u0438\u0446\u0430 \u0434\u0430\u0451\u0442 \u043E\u0431\u0437\u043E\u0440
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430 \u0432\u043E\u043A\u0440\u0443\u0433
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430, \u0430 \u0432\u0438\u0434
    \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u2014 \u043F\u043E\u043B\u043D\u043E\u0435
    \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0435. \u0412 \u0440\u0430\u0437\u043D\u044B\u0445
    \u0438\u0433\u0440\u0430\u0445 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u0440\u0430\u0437\u043D\u043E\u0435: \u0432 \u0448\u0443\u0442\u0435\u0440\u0430\u0445
    \u043B\u044E\u0431\u044F\u0442 \u043F\u0435\u0440\u0432\u044B\u0439, \u0432 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u0430\u0445
    \u0438 \u044D\u043A\u0448\u0435\u043D\u0430\u0445 \u2014 \u0442\u0440\u0435\u0442\u0438\u0439.
    \u0410 \u0447\u0442\u043E \u0443\u0434\u043E\u0431\u043D\u0435\u0435 \u0442\u0435\u0431\u0435?"
  tutorialMessages: []
  timedHints: []
