--- !u!114 &2080559494
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2080559491}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d146d7291398754d90e65fadde1ecce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EncyclopediaLevelIntro
  introDialogue:
  - "\u041F\u0440\u0438\u0432\u0435\u0442! \u041C\u044B \u0432 \u043C\u043E\u0435\u0439
    \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439... \u0432 \u0442\u0440\u0435\u0445\u043C\u0435\u0440\u043D\u043E\u043C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435."
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E
    \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435
    \u043D\u0430 [WASD], \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439."
  - "\u041F\u0440\u0430\u0432\u0434\u0430, \u0442\u0443\u0442 \u043A\u0430\u043A-\u0442\u043E
    \u043C\u0440\u0430\u0447\u043D\u043E. \u041D\u0430\u0439\u0434\u0438 \u043D\u0430
    \u0441\u0442\u043E\u043B\u0435 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u043D\u0438\u043A
    \u2014 \u0441 \u043D\u0438\u043C \u0431\u0443\u0434\u0435\u0442 \u0443\u044E\u0442\u043D\u0435\u0435,
    \u0434\u0430 \u0438 \u043C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u0433\u0434\u0435-\u0442\u043E \u0440\u044F\u0434\u043E\u043C, \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u043F\u043E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435..
    \u0438 \u0435\u0449\u0435 \u043F\u043E \u043E\u0434\u043D\u043E\u0439."
