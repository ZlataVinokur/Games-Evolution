--- !u!114 &1482632494
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1482632491}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0ea73e9489588c4988315bced6906bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScrollPickup
  scrollText: "\u0412 \u0434\u0432\u0443\u0445\u043C\u0435\u0440\u043D\u044B\u0445
    \u0438\u0433\u0440\u0430\u0445 \u0437\u0432\u0443\u043A \u0431\u044B\u043B \u043F\u043B\u043E\u0441\u043A\u0438\u043C:
    \u043E\u043D \u043B\u0438\u0431\u043E \u0438\u0433\u0440\u0430\u043B, \u043B\u0438\u0431\u043E
    \u043D\u0435\u0442. \u0412 3D \u043F\u043E\u044F\u0432\u0438\u043B\u043E\u0441\u044C
    \u043E\u0431\u044A\u0451\u043C\u043D\u043E\u0435 \u0437\u0432\u0443\u0447\u0430\u043D\u0438\u0435
    \u2014 \u0437\u0432\u0443\u043A \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
    \u0441\u043B\u0435\u0432\u0430, \u0441\u043F\u0440\u0430\u0432\u0430, \u0441\u0432\u0435\u0440\u0445\u0443,
    \u0441\u0437\u0430\u0434\u0438, \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0442\u044C\u0441\u044F
    \u0438 \u0443\u0434\u0430\u043B\u044F\u0442\u044C\u0441\u044F. \u042D\u0442\u043E
    \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E \u0445\u043E\u0440\u0440\u043E\u0440\u044B
    \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430: \u0442\u0435\u043F\u0435\u0440\u044C
    \u0432\u0440\u0430\u0433 \u043C\u043E\u0433 \u043F\u043E\u0434\u043A\u0440\u0430\u0441\u0442\u044C\u0441\u044F
    \u0441\u043E \u0441\u043F\u0438\u043D\u044B, \u0438 \u0442\u044B \u0441\u043B\u044B\u0448\u0430\u043B
    \u044D\u0442\u043E.\r\n\r\n\u041A\u0441\u0442\u0430\u0442\u0438, \u043E \u0437\u0432\u0443\u043A\u0430\u0445...
    \u0442\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043B\u044B\u0448\u0438\u0448\u044C?
    \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0433\u0434\u0435-\u0442\u043E \u0437\u0434\u0435\u0441\u044C
    \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435
    \u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0435. \u0412 \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u043E\u043C
    \u043C\u0438\u0440\u0435 \u0437\u0432\u0443\u043A \u2014 \u044D\u0442\u043E \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430,
    \u044D\u0442\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442.
    \u0421\u043B\u0435\u0434\u0443\u0439 \u0437\u0430 \u043D\u0438\u043C, \u0438
    \u043E\u043D \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u0442\u0435\u0431\u044F
    \u043A \u0446\u0435\u043B\u0438. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0435\u0441\u043B\u0438 \u0446\u0435\u043B\u044C \u043F\u0438\u0449\u0438\u0442,
    \u043A\u0430\u043A \u043C\u044B\u0448\u044C."
  scrollPanel: {fileID: 1388674789}
  scrollTextUI: {fileID: 942052520}
