--- !u!114 &634922645
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 634922642}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0ea73e9489588c4988315bced6906bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScrollPickup
  scrollText: "\u041F\u0435\u0440\u0432\u044B\u0435 3D-\u0438\u0433\u0440\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0438
    \u0443\u0433\u043B\u043E\u0432\u0430\u0442\u043E, \u0430 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B
    \u0431\u044B\u043B\u0438 \u0440\u0430\u0437\u043C\u044B\u0442\u044B\u043C\u0438.
    \u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 64x64 \u043F\u0438\u043A\u0441\u0435\u043B\u044F
    \u0441\u0447\u0438\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u043C
    \u2014 \u043D\u0430\u043B\u043E\u0436\u0438\u043B \u043D\u0430 \u044F\u0449\u0438\u043A,
    \u0438 \u0433\u043E\u0442\u043E\u0432\u043E. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0432\u0441\u0451 \u0438\u043D\u0430\u0447\u0435: \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B
    \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C\u0438,
    \u0430 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u2014 \u043E\u0442\u0440\u0430\u0436\u0430\u0442\u044C
    \u0441\u0432\u0435\u0442, \u0438\u043C\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0442\u043A\u0430\u043D\u044C, \u043C\u0435\u0442\u0430\u043B\u043B, \u0434\u0435\u0440\u0435\u0432\u043E.\r\n\r\n\u041D\u043E
    \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E?
    \u0414\u0430\u0436\u0435 \u0441 \u043F\u0440\u043E\u0441\u0442\u044B\u043C\u0438
    \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u0430\u043C\u0438 \u043C\u043E\u0436\u043D\u043E
    \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443,
    \u0435\u0441\u043B\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441\u043E \u0441\u0432\u0435\u0442\u043E\u043C
    \u0438 \u0442\u0435\u043D\u044F\u043C\u0438. \u041A\u0441\u0442\u0430\u0442\u0438,
    \u0441\u0432\u0435\u0442 \u0431\u044B\u0432\u0430\u0435\u0442 \u0440\u0430\u0437\u043D\u044B\u043C:
    \u0442\u043E\u0442, \u0447\u0442\u043E \u043E\u0442 \u043E\u0433\u043D\u044F
    \u2014 \u0442\u0451\u043F\u043B\u044B\u0439 \u0438 \u0436\u0438\u0432\u043E\u0439.
    \u041E\u043D \u043C\u043E\u0436\u0435\u0442 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0441\u0432\u0435\u0449\u0430\u0442\u044C, \u043D\u043E \u0438... \u043D\u0430\u0433\u0440\u0435\u0432\u0430\u0442\u044C.
    \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0440\u0435\u0442\u043E\u0440\u0442\u0443.
    \u041C\u043E\u0436\u0435\u0442, \u0435\u0439 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
    \u0442\u0435\u043F\u043B\u0430?"
  scrollPanel: {fileID: 1388674789}
  scrollTextUI: {fileID: 942052520}
