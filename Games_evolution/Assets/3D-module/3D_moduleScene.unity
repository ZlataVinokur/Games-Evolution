--- !u!114 &1238304896
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1238304893}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0ea73e9489588c4988315bced6906bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScrollPickup
  scrollText: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u044B\u0435
    \u0438\u0433\u0440\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0438\u0441\u044C
    \u0441 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u044B: \u0441\u0442\u0440\u0435\u043B\u043A\u0430\u043C\u0438
    \u0445\u043E\u0434\u0438\u043B\u0438, \u0430 \u043C\u044B\u0448\u044C\u044E \u0446\u0435\u043B\u0438\u043B\u0438\u0441\u044C.
    \u0414\u0436\u043E\u0439\u0441\u0442\u0438\u043A\u0438 \u0442\u043E\u0433\u0434\u0430
    \u0431\u044B\u043B\u0438 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C\u044E.
    \u041D\u043E \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0433\u0435\u0439\u043C\u043F\u0430\u0434\u044B
    \u0441 \u0430\u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u043C\u0438 \u0441\u0442\u0438\u043A\u0430\u043C\u0438
    \u0441\u0442\u0430\u043B\u0438 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043E\u043C
    \u2014 \u043E\u043D\u0438 \u0434\u0430\u0432\u0430\u043B\u0438 \u043F\u043B\u0430\u0432\u043D\u043E\u0435
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0432\u043C\u0435\u0441\u0442\u043E
    \u0440\u0435\u0437\u043A\u043E\u0433\u043E \"\u043D\u0430\u0436\u0430\u043B \u2014
    \u043F\u043E\u0448\u0451\u043B\".\r\n\r\n\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
    \u0447\u0442\u043E \u0432 \u0440\u0430\u0437\u043D\u044B\u0445 \u0436\u0430\u043D\u0440\u0430\u0445
    \u043F\u0440\u0438\u0436\u0438\u043B\u0438\u0441\u044C \u0440\u0430\u0437\u043D\u044B\u0435
    \u0441\u0445\u0435\u043C\u044B: \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430
    \u0438 \u043C\u044B\u0448\u044C \u0434\u043B\u044F \u0448\u0443\u0442\u0435\u0440\u043E\u0432,
    \u0433\u0435\u0439\u043C\u043F\u0430\u0434 \u0434\u043B\u044F \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u043E\u0432
    \u0438 \u0444\u0430\u0439\u0442\u0438\u043D\u0433\u043E\u0432. \u0410 \u043A\u0442\u043E-\u0442\u043E
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    Dark Souls \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435
    \u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043E
    \u044D\u0442\u043E \u0443\u0434\u043E\u0431\u043D\u043E. \u0422\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0430 \u0438 \u0442\u043E,
    \u0438 \u0434\u0440\u0443\u0433\u043E\u0435 \u2014 \u0438 \u0432\u0435\u0441\u044B
    \u0432\u044B\u0440\u043E\u0432\u043D\u044F\u043B\u0430, \u0438 \u0434\u043E \u0432\u0435\u0440\u0445\u0430
    \u0434\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C. \u041D\u0435\u043F\u043B\u043E\u0445\u043E
    \u0434\u043B\u044F \u0442\u043E\u0439, \u043A\u0442\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u043B\u0430
    \u043A\u0430\u043A \u0431\u0435\u043B\u044B\u0439 \u043A\u0432\u0430\u0434\u0440\u0430\u0442,
    \u043F\u0440\u0430\u0432\u0434\u0430?"
  scrollPanel: {fileID: 1388674789}
  scrollTextUI: {fileID: 942052520}
