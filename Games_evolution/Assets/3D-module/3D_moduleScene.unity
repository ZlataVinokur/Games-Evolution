    \u0441 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439: \u0438\u0433\u0440\u043E\u043A\u0438
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043F\u0440\u043E\u043C\u0430\u0445\u0438\u0432\u0430\u043B\u0438\u0441\u044C
    \u043C\u0438\u043C\u043E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C. \u0412
    2D \u043C\u044B \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u043B\u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
    \u043F\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0438
    \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438, \u0430 \u0442\u0435\u043F\u0435\u0440\u044C
    \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0433\u043B\u0443\u0431\u0438\u043D\u0430.
    \u0420\u0435\u0448\u0435\u043D\u0438\u0435? \u0422\u0435\u043D\u044C \u043F\u043E\u0434
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C. \u041F\u0440\u043E\u0441\u0442\u0430\u044F
    \u0447\u0451\u0440\u043D\u0430\u044F \u0442\u043E\u0447\u043A\u0430 \u043D\u0430
    \u0437\u0435\u043C\u043B\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430,
    \u043A\u0443\u0434\u0430 \u0442\u044B \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u0448\u044C\u0441\u044F.\r\n\r\n\u0421
    \u0442\u0435\u0445 \u043F\u043E\u0440 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u044B
    \u0432 3D \u043E\u0431\u0437\u0430\u0432\u0435\u043B\u0438\u0441\u044C \u0446\u0435\u043B\u044B\u043C
    \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u043E\u043C \u0442\u0440\u044E\u043A\u043E\u0432:
    \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u0435 \u043A\u0440\u0430\u044F
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C, \u0434\u0432\u043E\u0439\u043D\u044B\u0435
    \u043F\u0440\u044B\u0436\u043A\u0438, \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u0435
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u041D\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435
    \u043F\u0440\u0430\u0432\u0438\u043B\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u043F\u0440\u0435\u0436\u043D\u0438\u043C: \u0441\u043C\u043E\u0442\u0440\u0438
    \u0432\u043D\u0438\u0437. \u0422\u0432\u043E\u044F \u0442\u0435\u043D\u044C \u2014
    \u043B\u0443\u0447\u0448\u0438\u0439 \u0434\u0440\u0443\u0433. \u0410 \u0435\u0449\u0451
    \u043B\u0443\u0447\u0448\u0438\u0439 \u0434\u0440\u0443\u0433 \u2014 \u044D\u0442\u043E
    \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C
    \u043A\u0443\u0434\u0430 \u043D\u0430\u0434\u043E. \u0415\u0441\u043B\u0438,
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0445\u0432\u0430\u0442\u0438\u0442
    \u0441\u0438\u043B \u0435\u0451 \u043F\u043E\u0434\u043D\u044F\u0442\u044C."
  scrollPanel: {fileID: 1388674789}
  scrollTextUI: {fileID: 942052520}
