  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb6735586d048e842ad7265d2e3636fd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EncyclopediaOnMechanics
  movementFact:
  - "\u0420\u0430\u043D\u044C\u0448\u0435, \u0432 80-\u0445, \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438
    \u0434\u0432\u0438\u0433\u0430\u043B\u0438\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E 2D-\u0441\u0435\u0442\u043A\u0435."
  - "\u041A\u0441\u0442\u0430\u0442\u0438, \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0432 3D-\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435
    \u0441\u0442\u0430\u043B\u0430 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438
    '\u043C\u0430\u0442\u0440\u0438\u0446\u0430 \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438'."
  - "\u0420\u0430\u043D\u044C\u0448\u0435, \u0432 80-\u0445, \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438
    \u0434\u0432\u0438\u0433\u0430\u043B\u0438\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E 2D-\u0441\u0435\u0442\u043A\u0435."
  lightFact:
  - "\u041D\u0443 \u043A\u0440\u0430\u0441\u043E\u0442\u0430! \u0410 \u0442\u0435\u043F\u0435\u0440\u044C
    \u043D\u0430 \u0432\u0435\u0440\u0445."
  - "\u0410 \u0432\u043E\u0442 \u0438 \u043E\u043D, \u043C\u043E\u0436\u043D\u043E
    \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u0435\u0442\u0430!
    \u041D\u043E \u044D\u0442\u043E \u0435\u0449\u0435 \u043D\u0435 \u0432\u0441\u0435,
    \u0434\u0440\u0443\u0433\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0436\u0434\u0435\u0442 \u0437\u0430 \u0442\u043E\u043C\u0430\u043C\u0438. "
  - "\u0410 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
    \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 - \u044D\u0442\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439
    \u0430\u0441\u043F\u0435\u043A\u0442 \u0434\u043B\u044F \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430 \u0438
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B?
    \u0422\u0435\u043F\u0435\u0440\u044C \u0437\u043D\u0430\u0435\u0448\u044C."
  - "\u041D\u0443 \u043A\u0440\u0430\u0441\u043E\u0442\u0430! \u0410 \u0442\u0435\u043F\u0435\u0440\u044C
    \u043D\u0430 \u0432\u0435\u0440\u0445."
  cameraFact:
  - "\u042D\u0442\u043E \u0431\u044B\u043B \u043F\u0440\u043E\u0440\u044B\u0432 \u0432
    \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0438 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043C\u0438\u0440\u0430."
  - "\u0421\u0442\u0440\u0430\u0448\u043D\u043E \u043F\u0440\u044B\u0433\u0430\u0442\u044C
    \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435? \u041D\u0438\u0447\u0435\u0433\u043E,
    \u0437\u0430\u043A\u0440\u043E\u0439 \u0433\u043B\u0430\u0437\u0430 \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C
    \u0441\u0435\u0431\u044F \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B..."
  - "\u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u0442\u0435\u0431\u044F \u043A\u0443\u0434\u0430
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
    \u043D\u0430\u0434 \u043F\u0440\u044B\u0436\u043A\u043E\u043C, \u0430 \u0435\u0449\u0435
    \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u044E\u0431\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0441\u0435\u0431\u044F \u0438 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438."
  - "\u041A\u0430\u043C\u0435\u0440\u044B \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u0438 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043B\u0438\u0446\u0430
    \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0432 \u0438\u0433\u0440\u0435
    'Mario 64' \u0438 'Tomb Raider' (1996)."
  - "\u042D\u0442\u043E \u0431\u044B\u043B \u043F\u0440\u043E\u0440\u044B\u0432 \u0432
    \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0438 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043C\u0438\u0440\u0430."
  platformerFact:
  - "\u0412 3D \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0442\u0440\u0435\u0442\u044C\u044F
    \u043E\u0441\u044C \u2014 \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0443\u0436\u043D\u043E
    \u043F\u0440\u044B\u0433\u0430\u0442\u044C \u0435\u0449\u0451 \u0438 '\u043D\u0430
    \u0433\u043B\u0443\u0431\u0438\u043D\u0443'."
  - "\u0422\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C\u0441\u044F.
    \u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u044B \u0443\u0447\u0430\u0442
    \u0438\u0433\u0440\u043E\u043A\u0430 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0438 \u0432\u0440\u0435\u043C\u044F
    \u043F\u0440\u044B\u0436\u043A\u0430."
  - "\u0412 3D \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0442\u0440\u0435\u0442\u044C\u044F
    \u043E\u0441\u044C \u2014 \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0443\u0436\u043D\u043E
    \u043F\u0440\u044B\u0433\u0430\u0442\u044C \u0435\u0449\u0451 \u0438 '\u043D\u0430
    \u0433\u043B\u0443\u0431\u0438\u043D\u0443'."
  endFact:
  - "\u0422\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C\u0441\u044F.
    \u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u044B \u0443\u0447\u0430\u0442
    \u0438\u0433\u0440\u043E\u043A\u0430 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0442\u044C
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0438 \u0432\u0440\u0435\u043C\u044F
    \u043F\u0440\u044B\u0436\u043A\u0430."
  - "\u0412\u0430\u0443! \u0422\u044B \u043F\u0440\u043E\u0448\u043B\u0430 \u044D\u0442\u0438
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
    \u0437\u043D\u0430\u0435\u0448\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0431
    \u043E\u0441\u043D\u043E\u0432\u0430\u0445 \u0433\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D\u0430
    3D!"
