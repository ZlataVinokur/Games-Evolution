--- !u!114 &1285814807
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1285814802}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0ea73e9489588c4988315bced6906bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScrollPickup
  scrollText: "\xAB\u0422\u0440\u0435\u0442\u044C\u0435 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435
    \u0432 \u0438\u0433\u0440\u0430\u0445 \u2014 \u044D\u0442\u043E \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u043E.
    \u042D\u0442\u043E \u043D\u043E\u0432\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
    \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F. \u0412 2D \u0442\u044B \u0434\u0432\u0438\u0436\u0435\u0448\u044C\u0441\u044F
    \u043F\u043E \u043E\u0441\u044F\u043C X \u0438 Y \u2014 \u0432\u043B\u0435\u0432\u043E-\u0432\u043F\u0440\u0430\u0432\u043E,
    \u0432\u0432\u0435\u0440\u0445-\u0432\u043D\u0438\u0437. \u0412 3D \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0433\u043B\u0443\u0431\u0438\u043D\u0430 \u2014 \u043E\u0441\u044C Z.\r\n\r\n\u041F\u0435\u0440\u0432\u044B\u0435
    3D-\u0438\u0433\u0440\u044B \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0438\u0441\u044C
    \u0441 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439: \u043A\u0430\u043A
    \u0438\u0433\u0440\u043E\u043A\u0443 \u043F\u043E\u043D\u044F\u0442\u044C, \u0433\u0434\u0435
    \u043E\u043D \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435?
    \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B\u0438
    \u0442\u0435\u043D\u0435\u0439, \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435,
    \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B \u0441 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043E\u0439
    \u2014 \u0432\u0441\u0451, \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u0437\u0433
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u043E\u0431\u044A\u0451\u043C.\r\n\r\n\u0417\u0434\u0435\u0441\u044C,
    \u0432 \u044D\u0442\u043E\u0439 \u0431\u0430\u0448\u043D\u0435, \u0441\u0432\u0435\u0442
    \u2014 \u0442\u0432\u043E\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A.
    \u041D\u0435 \u0432\u0441\u0451 \u0432\u0438\u0434\u043D\u043E \u0441\u0440\u0430\u0437\u0443.
    \u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E,
    \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0439 \u0437\u0430 \u0443\u0433\u043B\u044B,
    \u0441\u043C\u043E\u0442\u0440\u0438 \u0432\u0432\u0435\u0440\u0445 \u0438 \u0432\u043D\u0438\u0437.
    \u0418 \u043F\u043E\u043C\u043D\u0438: \u0432 3D \u0442\u043E, \u0447\u0442\u043E
    \u0442\u044B \u043D\u0435 \u0432\u0438\u0434\u0438\u0448\u044C, \u0432\u0441\u0451
    \u0440\u0430\u0432\u043D\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442.\xBB"
  scrollPanel: {fileID: 1388674789}
  scrollTextUI: {fileID: 942052520}
