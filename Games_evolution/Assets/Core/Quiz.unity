  m_Script: {fileID: 11500000, guid: f8e2ae04d587720448699a7342d96345, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  quizPanel: {fileID: 944600267}
  questionText: {fileID: 1897513438}
  answerButtons:
  - {fileID: 969134509}
  - {fileID: 2057089702}
  - {fileID: 1149379322}
  finalPanel: {fileID: 1222480499}
  mainMenuButton: {fileID: 2026143429}
  nextModuleButton: {fileID: 1268376441}
  introPanel: {fileID: 774288443}
  startQuizButton: {fileID: 1365652758}
  flashImage: {fileID: 774288445}
  flashDuration: 0.3
  modules:
  - moduleSceneIndex: 1
    questions:
    - questionText: "\u041A\u0430\u043A\u0430\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430
        \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u0432 Arkanoid?"
      answers:
      - "\u0421\u0442\u0440\u0435\u043B\u044C\u0431\u0430"
      - "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0438 \u043E\u0442\u0441\u043A\u043E\u043A"
      - "\u0421\u0431\u043E\u0440 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432"
      correctAnswerIndex: 1
    - questionText: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0438\u044F
        \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0432 Space Invaders?"
      answers:
      - "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
        \u0436\u0438\u0437\u043D\u0435\u0439"
      - "\u041F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\u0435 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435
        \u0432\u0440\u0430\u0433\u043E\u0432 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439
        \u0432\u043E\u043B\u043D\u043E\u0439"
      - "\u041F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0431\u043E\u0441\u0441\u0430"
      correctAnswerIndex: 1
    - questionText: "\u0427\u0442\u043E \u0434\u0435\u043B\u0430\u044E\u0442 \u0441\u0443\u043F\u0435\u0440-\u0442\u043E\u0447\u043A\u0438
        \u0432 Pac-Man?"
      answers:
      - "\u0414\u0435\u043B\u0430\u044E\u0442 \u043F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u0439
        \u0443\u044F\u0437\u0432\u0438\u043C\u044B\u043C\u0438"
      - "\u0414\u0430\u044E\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
        \u0436\u0438\u0437\u043D\u044C"
      - "\u0417\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442 \u0432\u0440\u0435\u043C\u044F"
      correctAnswerIndex: 0
    - questionText: "\u041A\u0430\u043A\u0430\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430
        \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439
        \u0432 Tetris?"
      answers:
      - "\u0421\u0431\u043E\u0440 \u043C\u043E\u043D\u0435\u0442"
      - "\u0421\u0442\u0440\u0435\u043B\u044C\u0431\u0430 \u043F\u043E \u0432\u0440\u0430\u0433\u0430\u043C"
      - "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0430\u0434\u0430\u044E\u0449\u0438\u043C\u0438
        \u0444\u0438\u0433\u0443\u0440\u0430\u043C\u0438 \u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
        \u0440\u044F\u0434\u043E\u0432"
      correctAnswerIndex: 2
    - questionText: "\u041A\u0430\u043A\u043E\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
        \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0432\u0432\u0451\u043B \u0441\u0438\u0441\u0442\u0435\u043C\u0443
        \u0432\u043E\u043B\u043D \u0438 \u044D\u0441\u043A\u0430\u043B\u0430\u0446\u0438\u044E
        \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438?"
      answers:
      - Space Invaders
      - Arkanoid
