  m_Script: {fileID: 11500000, guid: 0b63f342b65c278498468cb98ed594a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExitPortal
  capabilities: 1
  useableItemIds: []
  dialogueOnLook: []
  itemIdToPickUp: 
  failDialogue:
  - "\u041E\u0439, \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442...
    \u041D\u0430\u0434\u043E \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u043A\u0443\u0434\u0430
    \u0435\u0449\u0451 \u044D\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C."
  articleTriggerId: 
  flagToSetOnAction: 
  speaker: 1
  nextSceneName: Level2_Platformer
  portalDialogue:
  - "\u0417\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043B\u0435\u0441
    \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0437\u0430\u0434\u0438.
    \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u2014 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439
    \u0442\u043E\u043D\u043D\u0435\u043B\u044C."
  - "\u0422\u0430\u043C \u0442\u0435\u0431\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
    \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
    \u0438 \u043F\u0440\u044B\u0433\u0430\u0442\u044C. \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440!"
  - "\u041F\u043E\u043C\u043D\u0438: \u043A\u0430\u0436\u0434\u0430\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430
    \u2014 \u0448\u0430\u0433 \u0432 \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u0438
    \u0438\u0433\u0440."
