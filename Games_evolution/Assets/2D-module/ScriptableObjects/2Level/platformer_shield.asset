  articleId: platformer_shield
  title: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F"
  fullText: "\u0429\u0438\u0442 \u0441\u0434\u0435\u043B\u0430\u043B \u0438\u0433\u0440\u043E\u043A\u0430
    \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u044B\u043C \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0435\u043A\u0443\u043D\u0434. \u042D\u0442\u043E \u0434\u0430\u043B\u043E
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0431\u0435\u0433\u0430\u0442\u044C
    \u0441\u043A\u0432\u043E\u0437\u044C \u0432\u0440\u0430\u0433\u043E\u0432 \u0438
    \u0441\u0431\u0438\u0432\u0430\u0442\u044C \u0438\u0445. \u0422\u0430\u043A\u0438\u0435
    \u0431\u043E\u043D\u0443\u0441\u044B \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0438
    \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0432\u044B\u0431\u043E\u0440:
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441\u0435\u0439\u0447\u0430\u0441
    \u0438\u043B\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043D\u0430
    \u043F\u043E\u0442\u043E\u043C."
  shortAnnotation: "\u0429\u0438\u0442 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D!
    \u0412\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C
    \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0431\u043E\u043D\u0443\u0441\u044B
    \u0432 \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043C\u0435\u0441\u0442\u0430\u0445."
