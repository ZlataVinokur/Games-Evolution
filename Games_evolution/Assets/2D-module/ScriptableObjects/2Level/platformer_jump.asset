  articleId: platformer_jump
  title: "\u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u0440\u044B\u0436\u043A\u0430"
  fullText: "\u041F\u0440\u044B\u0436\u043E\u043A \u2014 \u043E\u0441\u043D\u043E\u0432\u0430
    \u0436\u0430\u043D\u0440\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440.
    \u0412 1980 \u0433\u043E\u0434\u0443 \u0438\u0433\u0440\u0430 \xABPac-Man\xBB
    \u043D\u0435 \u0438\u043C\u0435\u043B\u0430 \u043F\u0440\u044B\u0436\u043A\u0430,
    \u043D\u043E \u0443\u0436\u0435 \u0432 1981-\u043C \xABDonkey Kong\xBB \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B
    \u041C\u0430\u0440\u0438\u043E, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u043C\u0435\u043B
    \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0442\u044C
    \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F.
    \u041F\u0440\u044B\u0436\u043E\u043A \u0434\u043E\u0431\u0430\u0432\u0438\u043B
    \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0435 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435
    \u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u043B \u0433\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D
    \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
  shortAnnotation: "\u041F\u0440\u044B\u0436\u043E\u043A \u2014 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430
    \u0438\u0433\u0440\u044B \u0438\u0437 \u043B\u0438\u043D\u0435\u0439\u043D\u044B\u0445
    \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u043E\u0432 \u0432 \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u043D\u044B\u0435
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F."
