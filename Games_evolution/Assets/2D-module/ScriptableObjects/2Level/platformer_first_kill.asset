  articleId: platformer_first_kill
  title: "\u0412\u0440\u0430\u0433\u0438 \u043A\u0430\u043A \u0446\u0435\u043B\u044C"
  fullText: "\u0420\u0430\u043D\u043D\u0438\u0435 \u0432\u0440\u0430\u0433\u0438
    \u0432 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u0430\u0445
    \u0431\u044B\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043C\u0435\u0445\u0430\u043C\u0438.
    \u041D\u043E \u0441 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435\u043C
    \u043E\u0440\u0443\u0436\u0438\u044F \u0432\u0440\u0430\u0433\u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0438\u0441\u044C
    \u0432 \u043C\u0438\u0448\u0435\u043D\u0438. \u0418\u0433\u0440\u0430 \xABMega
    Man\xBB (1987) \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0435
    \u0432\u0440\u0430\u0433\u043E\u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C
    \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0438.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E
    \u0432\u0440\u0430\u0433\u043E\u0432 \u2014 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0438\u0438."
  shortAnnotation: "\u0422\u044B \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u043B
    \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0432\u0440\u0430\u0433\u0430! \u0412
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u043C \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u0435
    \u0441\u0447\u0451\u0442\u0447\u0438\u043A \u0443\u0431\u0438\u0439\u0441\u0442\u0432
    \u0447\u0430\u0441\u0442\u043E \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430
    \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u043C."
  tutorialMessages: []
  timedHints: []
