  articleId: article_arcade
  title: "\u0410\u0440\u043A\u0430\u0434\u043D\u044B\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B:
    \u043C\u043E\u043D\u0435\u0442\u043A\u0430 \u0432 \u043C\u0438\u0440 \u0438\u0433\u0440"
  fullText: "\u0414\u043E \u0442\u043E\u0433\u043E \u043A\u0430\u043A \u0438\u0433\u0440\u044B
    \u043F\u0440\u0438\u0448\u043B\u0438 \u0432 \u043A\u0430\u0436\u0434\u044B\u0439
    \u0434\u043E\u043C, \u043E\u043D\u0438 \u0436\u0438\u043B\u0438 \u0432 \u0430\u0440\u043A\u0430\u0434\u043D\u044B\u0445
    \u0437\u0430\u043B\u0430\u0445. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u044B
    \u0432\u0440\u043E\u0434\u0435 Pac-Man (1980) \u0438 Donkey Kong (1981) \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438
    \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435 \u043E\u043F\u0443\u0441\u043A\u0430\u043D\u0438\u044F
    \u043C\u043E\u043D\u0435\u0442\u043A\u0438 \u0438\u043B\u0438 \u0436\u0435\u0442\u043E\u043D\u0430.
    \u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u0440\u0435\u043C\u043E\u043D\u0442\u0430
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u0432 \u043D\u0430\u0448\u0435\u043C
    \u043A\u0432\u0435\u0441\u0442\u0435 \u043E\u0442\u0441\u044B\u043B\u0430\u0435\u0442
    \u043A \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0438\u0433\u0440\u044B
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0438
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0447\u0430\u0441\u0442\u0438\u044F,
    \u043D\u043E \u0438 \u0438\u043D\u043E\u0433\u0434\u0430 \u2014 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0441\u043C\u0435\u043A\u0430\u043B\u043A\u0438."
  shortAnnotation: "\u0410\u0440\u043A\u0430\u0434\u043D\u044B\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0437\u0430 \u043C\u043E\u043D\u0435\u0442\u043A\u0438
    \u0438 \u0441\u0442\u0430\u043B\u0438 \u043F\u0435\u0440\u0432\u044B\u043C\u0438
    \u0438\u0433\u0440\u043E\u0432\u044B\u043C\u0438 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u043C\u0438."
