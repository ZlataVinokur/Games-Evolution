  title: "\u0411\u043E\u0435\u0432\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438"
  fullText: "\u0411\u043E\u0435\u0432\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438"
  shortAnnotation: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0435
    \u0432\u0440\u0430\u0433\u043E\u0432 \u0441\u0442\u0430\u043B\u043E \u043D\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C
    \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u044F, \u043D\u043E \u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C
    \u043E\u0447\u043A\u043E\u0432 \u0438 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430."
