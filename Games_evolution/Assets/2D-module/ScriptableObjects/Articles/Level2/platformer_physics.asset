  title: "\u0413\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F \u0438 \u043F\u0440\u044B\u0436\u043E\u043A"
  fullText: "\u0413\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F \u0438
    \u043F\u0440\u044B\u0436\u043E\u043A"
  shortAnnotation: "\u0412 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u0430\u0445
    \u043A\u043B\u044E\u0447\u0435\u0432\u0443\u044E \u0440\u043E\u043B\u044C \u0438\u0433\u0440\u0430\u0435\u0442
