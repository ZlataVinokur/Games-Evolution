  moduleIndex: 1
  articleId: rpg_logic
  title: "\u042D\u0432\u043E\u043B\u044E\u0446\u0438\u044F \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043E\u043A \u0432 \u043A\u0432\u0435\u0441\u0442\u0430\u0445
    \u0438 RPG"
  fullText: "\u041E\u0442 \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \xAB\u043D\u0430\u0439\u0442\u0438
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0410 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C
    \u043A \u043E\u0431\u044A\u0435\u043A\u0442\u0443 \u0411\xBB \u0434\u043E \u0441\u043B\u043E\u0436\u043D\u044B\u0445
    \u0441\u0438\u0441\u0442\u0435\u043C \u0441 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0451\u043C,
    \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F\u043C\u0438 \u0438
    \u0441\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u043A\u043E\u0434\u0430\u043C\u0438
    (Konami Code!). \u041B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0442
    \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u043E\u0435 \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0435
    \u0438 \u0431\u044B\u043B\u0438 \u043E\u0441\u043D\u043E\u0432\u043E\u0439 \u0436\u0430\u043D\u0440\u0430
    point-and-click (Monkey Island, Broken Sword). \u0412 RPG \u043E\u043D\u0438
    \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u0433\u043B\u0443\u0431\u0438\u043D\u044B
    \u0438 \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u044F."
  shortAnnotation: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432
    \u2013 \u043A\u043B\u0430\u0441\u0441\u0438\u043A\u0430 \u043A\u0432\u0435\u0441\u0442\u043E\u0432\u044B\u0445
    \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043E\u043A. \u041C\u043E\u043B\u043E\u0434\u0435\u0446,
    \u0447\u0442\u043E \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F!"
  tutorialMessages: []
  timedHints: []
