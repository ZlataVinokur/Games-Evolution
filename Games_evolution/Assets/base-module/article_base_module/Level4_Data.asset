  title: "\u0410\u0440\u043A\u0430\u043D\u043E\u0438\u0434: \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438 \u043E\u0442\u0441\u043A\u043E\u043A\u0430"
  fullText: "\u0412 1984 \u0433\u043E\u0434\u0443 \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442 \u0410\u043B\u0435\u043A\u0441\u0435\u0439
    \u041F\u0430\u0436\u0438\u0442\u043D\u043E\u0432 \u0441\u043E\u0437\u0434\u0430\u043B
    \xAB\u0422\u0435\u0442\u0440\u0438\u0441\xBB \u2014 \u0438\u0433\u0440\u0443,
    \u0433\u0434\u0435 \u043D\u0435\u0442 \u0433\u0435\u0440\u043E\u0435\u0432, \u0441\u044E\u0436\u0435\u0442\u0430
    \u0438 \u0432\u0440\u0430\u0433\u043E\u0432. \u0422\u043E\u043B\u044C\u043A\u043E
    \u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0435 \u0444\u0438\u0433\u0443\u0440\u044B,
    \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
    \u0440\u044F\u0434\u043E\u0432. \u042D\u0442\u043E \u0447\u0438\u0441\u0442\u0430\u044F
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043B\u0430 \u0432\u0435\u0441\u044C
    \u043C\u0438\u0440. \u0413\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D
    \u0433\u0435\u043D\u0438\u0430\u043B\u0435\u043D: \u0441\u0435\u043C\u044C \u0444\u0438\u0433\u0443\u0440
    (\u0442\u0435\u0442\u0440\u0430\u043C\u0438\u043D\u043E) \u043F\u0430\u0434\u0430\u044E\u0442
    \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
    \u0438\u0433\u0440\u043E\u043A \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u0440\u0430\u0449\u0430\u0442\u044C
    \u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C \u0438\u0445,
    \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
    \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0440\u044F\u0434\u044B. \u0417\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0439
    \u0440\u044F\u0434 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442, \u0430 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
    \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442
    \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u043E\u0447\u043A\u043E\u043C. \u042D\u0442\u043E
    \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u044D\u0444\u0444\u0435\u043A\u0442
    \xAB\u043F\u043E\u0442\u043E\u043A\u0430\xBB \u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0433\u043E
    \u0441\u0442\u0440\u0435\u0441\u0441\u0430. \u041A\u043B\u044E\u0447\u0435\u0432\u043E\u0439
    \u043D\u0430\u0432\u044B\u043A \u2014 \u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0430
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0434\u043E\u0432
    \u0432\u043F\u0435\u0440\u0451\u0434, \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \xAB\u0434\u044B\u0440\u043A\u0438\xBB \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0434\u043B\u0438\u043D\u043D\u044B\u0435 \u043F\u0430\u043B\u043A\u0438 \u0434\u043B\u044F
    \u043E\u0447\u0438\u0441\u0442\u043A\u0438 \u0447\u0435\u0442\u044B\u0440\u0451\u0445
    \u0440\u044F\u0434\u043E\u0432 \u0441\u0440\u0430\u0437\u0443 (\u0442\u0435\u0442\u0440\u0438\u0441).
    \u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u044E\u0449\u0435\u0439
    \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u0438
    \u0434\u0435\u043B\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u0443\u044E \u043F\u0430\u0440\u0442\u0438\u044E
    \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439. \xAB\u0422\u0435\u0442\u0440\u0438\u0441\xBB
    \u0434\u043E\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0438\u0433\u0440\u0430
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E\u0439
    \u0431\u0435\u0437 \u043D\u0430\u0440\u0440\u0430\u0442\u0438\u0432\u0430. \u041D\u0430\u0448
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C 4 \u2014 \u044D\u0442\u043E \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u044F
    \u044D\u0442\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438: \u0444\u0438\u0433\u0443\u0440\u044B
    \u043F\u0430\u0434\u0430\u044E\u0442 \u0441\u0432\u0435\u0440\u0445\u0443, \u0432\u044B
    \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0435 \u0438 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0435
    \u0438\u0445, \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0435 \u0440\u044F\u0434\u044B.
    \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u044F\u0434\u043E\u0432
    \u0437\u0430 \u0440\u0430\u0437, \u0442\u0435\u043C \u0432\u044B\u0448\u0435
    \u0441\u0447\u0451\u0442 \u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043F\u0430\u0434\u0435\u043D\u0438\u0435.
    \u042D\u0442\u043E \u0442\u0440\u0435\u043D\u0438\u0440\u0443\u0435\u0442 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442 \u0438 \u0440\u0435\u0430\u043A\u0446\u0438\u044E.
    \u0413\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0438 \u0442\u0430\u043A\u043E\u0433\u043E
    \u0442\u0438\u043F\u0430 \u0441\u0442\u0430\u043B\u0438 \u043E\u0441\u043D\u043E\u0432\u043E\u0439
    \u0432\u0441\u0435\u0445 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445
    \u043A\u0430\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0445 \u0438 \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0438\u0433\u0440."
  shortAnnotation: []
  tutorialMessages:
  - "\u041F\u0418\u041A\u0421\u0415\u041B\u042C, \u0417\u0414\u0415\u0421\u042C \u041D\u0415\u0422
    \u0412\u0420\u0410\u0413\u041E\u0412, \u0422\u041E\u041B\u042C\u041A\u041E \u0427\u0418\u0421\u0422\u041E\u0415
    \u041F\u0420\u041E\u0421\u0422\u0420\u0410\u041D\u0421\u0422\u0412\u0415\u041D\u041D\u041E\u0415
    \u041C\u042B\u0428\u041B\u0415\u041D\u0418\u0415. \u0421\u0412\u0415\u0420\u0425\u0423
    \u041F\u0410\u0414\u0410\u042E\u0422 \u0424\u0418\u0413\u0423\u0420\u042B, \u0412\u0420\u0410\u0429\u0410\u0419
    \u0418 \u0414\u0412\u0418\u0413\u0410\u0419 \u0418\u0425. \u0417\u0410\u0414\u0410\u0427\u0410
    \u2014 \u0423\u041A\u041B\u0410\u0414\u042B\u0412\u0410\u0422\u042C \u0424\u0418\u0413\u0423\u0420\u042B
    \u0422\u0410\u041A, \u0427\u0422\u041E\u0411\u042B \u0417\u0410\u041F\u041E\u041B\u041D\u042F\u0422\u042C
    \u0413\u041E\u0420\u0418\u0417\u041E\u041D\u0422\u0410\u041B\u042C\u041D\u042B\u0415
    \u0420\u042F\u0414\u042B. \u0417\u0410\u041F\u041E\u041B\u041D\u0415\u041D\u041D\u042B\u0419
    \u0420\u042F\u0414 \u0418\u0421\u0427\u0415\u0417\u0410\u0415\u0422 \u2014 \u042D\u0422\u041E
    \u041F\u041E\u0411\u0415\u0414\u0410."
  - "\u0427\u0415\u041C \u0411\u041E\u041B\u042C\u0428\u0415 \u0420\u042F\u0414\u041E\u0412
    \u0417\u0410 \u041E\u0414\u0418\u041D \u0420\u0410\u0417, \u0422\u0415\u041C
    \u0411\u041E\u041B\u042C\u0428\u0415 \u041E\u0427\u041A\u041E\u0412. 4 \u0420\u042F\u0414\u0410
    \u0421\u0420\u0410\u0417\u0423 \u2014 \u0413\u041B\u0410\u0412\u041D\u042B\u0419
    \u041D\u0410\u0412\u042B\u041A. \u0421\u041A\u041E\u0420\u041E\u0421\u0422\u042C
    \u041F\u0410\u0414\u0415\u041D\u0418\u042F \u0420\u0410\u0421\u0422\u0401\u0422
    \u0421 \u041E\u0427\u041A\u0410\u041C\u0418. \u042D\u0422\u041E \u041C\u0415\u0425\u0410\u041D\u0418\u041A\u0410
    \u041D\u0410\u0420\u0410\u0421\u0422\u0410\u042E\u0429\u0415\u0419 \u0421\u041B\u041E\u0416\u041D\u041E\u0421\u0422\u0418.
    \u041D\u0423\u0416\u041D\u041E \u0412\u0418\u0414\u0415\u0422\u042C \u041D\u0410
    \u041D\u0415\u0421\u041A\u041E\u041B\u042C\u041A\u041E \u0425\u041E\u0414\u041E\u0412
    \u0412\u041F\u0415\u0420\u0401\u0414."
  - "\u0424\u0418\u0413\u0423\u0420\u042B \u041F\u0420\u0418\u0425\u041E\u0414\u042F\u0422
    \u0412 \u0421\u041B\u0423\u0427\u0410\u0419\u041D\u041E\u041C \u041F\u041E\u0420\u042F\u0414\u041A\u0415
    \u2014 \u041A\u0410\u0416\u0414\u0410\u042F \u041F\u0410\u0420\u0422\u0418\u042F
    \u0423\u041D\u0418\u041A\u0410\u041B\u042C\u041D\u0410. \u0422\u042B \u0423\u0427\u0418\u0428\u042C\u0421\u042F
    \u0410\u0414\u0410\u041F\u0422\u0418\u0420\u041E\u0412\u0410\u0422\u042C\u0421\u042F
    \u0418 \u0411\u042B\u0421\u0422\u0420\u041E \u041F\u0420\u0418\u041D\u0418\u041C\u0410\u0422\u042C
    \u0420\u0415\u0428\u0415\u041D\u0418\u042F. \u042D\u0422\u0410 \u041C\u0415\u0425\u0410\u041D\u0418\u041A\u0410
    \u2014 \u041E\u0421\u041D\u041E\u0412\u0410 \u0412\u0421\u0415\u0425 \u0421\u041E\u0412\u0420\u0415\u041C\u0415\u041D\u041D\u042B\u0425
    \u0413\u041E\u041B\u041E\u0412\u041E\u041B\u041E\u041C\u041E\u041A."
  - "\u042D\u0422\u0410 \u0418\u0413\u0420\u0410 \u0418\u0417\u041C\u0415\u041D\u0418\u041B\u0410
    \u041F\u0420\u0415\u0414\u0421\u0422\u0410\u0412\u041B\u0415\u041D\u0418\u0415
    \u041E \u0422\u041E\u041C, \u041A\u0410\u041A\u041E\u0419 \u041C\u041E\u0416\u0415\u0422
    \u0411\u042B\u0422\u042C \u0418\u0413\u0420\u0410: \u041D\u0418\u041A\u0410\u041A\u041E\u0413\u041E
    \u0421\u042E\u0416\u0415\u0422\u0410, \u041D\u0418\u041A\u0410\u041A\u0418\u0425
    \u0413\u0415\u0420\u041E\u0415\u0412 \u2014 \u0422\u041E\u041B\u042C\u041A\u041E
    \u0424\u0418\u0413\u0423\u0420\u042B, \u0420\u042F\u0414\u042B \u0418 \u0423\u0421\u041A\u041E\u0420\u0415\u041D\u0418\u0415.
    \u042D\u0422\u041E \u0427\u0418\u0421\u0422\u0410\u042F \u041C\u0415\u0425\u0410\u041D\u0418\u041A\u0410.
    \u0414\u0410\u0412\u0410\u0419, \u041F\u0418\u041A\u0421\u0415\u041B\u042C, \u041F\u041E\u041A\u0410\u0416\u0418,
    \u041A\u0410\u041A \u0422\u042B \u0423\u041C\u0415\u0415\u0428\u042C \u0414\u0423\u041C\u0410\u0422\u042C!"
  timedHints:
  - delayAfterStart: 15
    message: "\u0421\u0422\u0410\u0420\u0410\u0419\u0421\u042F \u0423\u041A\u041B\u0410\u0414\u042B\u0412\u0410\u0422\u042C
      \u0424\u0418\u0413\u0423\u0420\u042B \u0420\u041E\u0412\u041D\u041E, \u0411\u0415\u0417
      \u041F\u0423\u0421\u0422\u041E\u0422. \u0422\u0410\u041A \u041B\u0415\u0413\u0427\u0415
      \u0417\u0410\u041F\u041E\u041B\u041D\u042F\u0422\u042C \u0420\u042F\u0414\u042B."
    duration: 5
  - delayAfterStart: 25
    message: "\u041F\u041E\u0412\u041E\u0420\u0410\u0427\u0418\u0412\u0410\u0419
      \u0424\u0418\u0413\u0423\u0420\u042B \u0417\u0410\u0420\u0410\u041D\u0415\u0415
      \u2014 \u041D\u0415 \u0416\u0414\u0418, \u041F\u041E\u041A\u0410 \u041E\u041D\u0418
      \u0423\u041F\u0410\u0414\u0423\u0422 \u041D\u0418\u0417\u041A\u041E. \u0421\u041A\u041E\u0420\u041E\u0421\u0422\u042C
      \u0411\u0423\u0414\u0415\u0422 \u0420\u0410\u0421\u0422\u0418!"
    duration: 5
