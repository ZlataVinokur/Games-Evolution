  title: "\u0410\u0440\u043A\u0430\u043D\u043E\u0438\u0434: \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438 \u043E\u0442\u0441\u043A\u043E\u043A\u0430"
  fullText: "\u0412 1980 \u0433\u043E\u0434\u0443 \u0422\u043E\u0440\u0443 \u0418\u0432\u0430\u0442\u0430\u043D\u0438
    \u0438\u0437 Namco \u0441\u043E\u0437\u0434\u0430\u043B \xABPac-Man\xBB \u2014
    \u0438\u0433\u0440\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u0430
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430\u0445 \u0438 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438.
    \u0412\u043C\u0435\u0441\u0442\u043E \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B
    \u2014 \u0441\u0431\u043E\u0440 \u0442\u043E\u0447\u0435\u043A \u0438 \u0443\u0445\u043E\u0434
    \u043E\u0442 \u043F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u0439. \u0413\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D
    \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u0430 \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0442\u0440\u0451\u0445 \u043A\u0438\u0442\u0430\u0445: \u0441\u0431\u043E\u0440
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432, \u0440\u0430\u0437\u043D\u043E\u0435
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432\u0440\u0430\u0433\u043E\u0432
    \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \xAB\u0441\u0443\u043F\u0435\u0440-\u0442\u043E\u0447\u0435\u043A\xBB (\u0443\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u0435\u0439).
    \u041F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u044F \u0438\u043C\u0435\u044E\u0442
    \u0441\u0432\u043E\u0438 \u0440\u043E\u043B\u0438: Blinky \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u0442,
    Pinky \u0437\u0430\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442, Inky \u0432\u0435\u0434\u0451\u0442
    \u0441\u0435\u0431\u044F \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u043E,
    Clyde \u0445\u0430\u043E\u0442\u0438\u0447\u0435\u043D. \u0418\u0433\u0440\u043E\u043A
    \u0443\u0447\u0438\u0442\u0441\u044F \u0447\u0438\u0442\u0430\u0442\u044C \u0438\u0445
    \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u044B \u0438 \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442. \u0421\u0443\u043F\u0435\u0440-\u0442\u043E\u0447\u043A\u0438
    \u0432 \u0443\u0433\u043B\u0430\u0445 \u0434\u0430\u044E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0443\u044E
    \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C \u0438
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0435\u0441\u0442\u044C
    \u0432\u0440\u0430\u0433\u043E\u0432, \u043F\u0440\u0438\u0447\u0451\u043C \u0437\u0430
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u044A\u0435\u0434\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u043E\u0434\u0440\u044F\u0434 \u0434\u0430\u0451\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0435
    \u043E\u0447\u043A\u043E\u0432 \u2014 \u0441\u0442\u0438\u043C\u0443\u043B \u043A
    \u0440\u0438\u0441\u043A\u0443. \u0422\u0443\u043D\u043D\u0435\u043B\u0438-\u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u044B
    \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0443\u0439\u0442\u0438 \u043E\u0442
    \u043F\u043E\u0433\u043E\u043D\u0438 \u0438 \u043C\u0435\u043D\u044F\u044E\u0442
    \u0442\u0430\u043A\u0442\u0438\u043A\u0443. \u041D\u0430\u0448 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    3 \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442
    \u044D\u0442\u0443 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0443: \u0441\u0431\u043E\u0440
    \u0432\u0441\u0435\u0445 \u0442\u043E\u0447\u0435\u043A, \u0438\u0437\u0431\u0435\u0433\u0430\u043D\u0438\u0435
    \u043F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u0439, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0441\u0443\u043F\u0435\u0440-\u0442\u043E\u0447\u0435\u043A \u0438 \u0442\u043E\u043D\u043D\u0435\u043B\u0435\u0439.
    \u041B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u043D\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438
    \u043F\u0435\u0440\u0435\u043A\u043E\u0447\u0435\u0432\u0430\u043B\u0438 \u0432
    \u043A\u0432\u0435\u0441\u0442\u044B, RPG \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435
    \u043C\u0438\u0440\u044B \u2014 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F,
    \u043F\u0430\u0442\u0440\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432\u0440\u0430\u0433\u043E\u0432, \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043C\u0438. \u0412\u044B \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0435\u0433\u0430\u0435\u0442\u0435,
    \u0432\u044B \u0438\u0437\u0443\u0447\u0430\u0435\u0442\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
    \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0435."
  shortAnnotation: []
  tutorialMessages:
  - "\u041F\u0418\u041A\u0421\u0415\u041B\u042C, \u0422\u0415\u041F\u0415\u0420\u042C
    \u0422\u042B \u041F\u041E\u041F\u0410\u041B \u0412 \u041B\u0410\u0411\u0418\u0420\u0418\u041D\u0422.
    \u0426\u0415\u041B\u042C \u2014 \u0421\u041E\u0411\u0420\u0410\u0422\u042C \u0412\u0421\u0415
    \u0422\u041E\u0427\u041A\u0418, \u0418\u0417\u0411\u0415\u0413\u0410\u042F \u041F\u0420\u0418\u0412\u0418\u0414\u0415\u041D\u0418\u0419.
    \u042D\u0422\u041E \u041C\u0415\u0425\u0410\u041D\u0418\u041A\u0410 \u0421\u0411\u041E\u0420\u0410
    \u041F\u0420\u0415\u0414\u041C\u0415\u0422\u041E\u0412 \u0418 \u041D\u0410\u0412\u0418\u0413\u0410\u0426\u0418\u0418.
    \u041F\u0420\u0418\u0412\u0418\u0414\u0415\u041D\u0418\u042F \u041F\u0420\u0415\u0421\u041B\u0415\u0414\u0423\u042E\u0422
    \u0422\u0415\u0411\u042F \u041F\u041E-\u0420\u0410\u0417\u041D\u041E\u041C\u0423.
    \u0423\u0427\u0418\u0421\u042C \u0418\u0425 \u0427\u0418\u0422\u0410\u0422\u042C!"
  - "\u0412 \u0423\u0413\u041B\u0410\u0425 \u041B\u0410\u0411\u0418\u0420\u0418\u041D\u0422\u0410
    \u0415\u0421\u0422\u042C \u0421\u0423\u041F\u0415\u0420-\u0422\u041E\u0427\u041A\u0418.
    \u0421\u042A\u0415\u0412 \u0418\u0425, \u0422\u042B \u0421\u041C\u041E\u0416\u0415\u0428\u042C
    \u0415\u0421\u0422\u042C \u041F\u0420\u0418\u0412\u0418\u0414\u0415\u041D\u0418\u0419
    \u041D\u0410 \u041A\u041E\u0420\u041E\u0422\u041A\u041E\u0415 \u0412\u0420\u0415\u041C\u042F.
    \u0417\u0410 \u041A\u0410\u0416\u0414\u041E\u0415 \u0421\u042A\u0415\u0414\u0415\u041D\u041D\u041E\u0415
    \u041F\u0420\u0418\u0412\u0418\u0414\u0415\u041D\u0418\u0415 \u0414\u0410\u0401\u0422\u0421\u042F
    \u0412\u0421\u0401 \u0411\u041E\u041B\u042C\u0428\u0415 \u041E\u0427\u041A\u041E\u0412.
    \u042D\u0422\u041E \u041C\u0415\u0425\u0410\u041D\u0418\u041A\u0410 \xAB\u041D\u0410\u0413\u0420\u0410\u0414\u0410
    \u0417\u0410 \u0420\u0418\u0421\u041A\xBB."
  - "\u0422\u0410\u041A\u0416\u0415 \u041F\u041E \u0411\u041E\u041A\u0410\u041C \u0415\u0421\u0422\u042C
    \u0422\u0423\u041D\u041D\u0415\u041B\u0418, \u041A\u041E\u0422\u041E\u0420\u042B\u0415
    \u0422\u0415\u041B\u0415\u041F\u041E\u0420\u0422\u0418\u0420\u0423\u042E\u0422
    \u0422\u0415\u0411\u042F \u041D\u0410 \u0414\u0420\u0423\u0413\u0423\u042E \u0421\u0422\u041E\u0420\u041E\u041D\u0423.
    \u042D\u0422\u041E \u041F\u041E\u041C\u041E\u0413\u0410\u0415\u0422 \u0421\u041F\u0410\u0421\u0422\u0418\u0421\u042C
    \u041E\u0422 \u041F\u041E\u0413\u041E\u041D\u0418. \u0417\u0410\u041F\u041E\u041C\u041D\u0418:
    \u041F\u0420\u0418\u0412\u0418\u0414\u0415\u041D\u0418\u042F \u041D\u0415 \u0414\u0423\u041C\u0410\u042E\u0422,
    \u0410 \u0414\u0415\u0419\u0421\u0422\u0412\u0423\u042E\u0422 \u041F\u041E \u0428\u0410\u0411\u041B\u041E\u041D\u0423.
    \u041D\u0410\u0423\u0427\u0418\u0421\u042C \u0418\u0425 \u041E\u0411\u041C\u0410\u041D\u042B\u0412\u0410\u0422\u042C!"
  - "\u041C\u0415\u0425\u0410\u041D\u0418\u041A\u0418 (\u0421\u0411\u041E\u0420 \u041F\u0420\u0415\u0414\u041C\u0415\u0422\u041E\u0412,
    \u0420\u0410\u0417\u041D\u041E\u0415 \u041F\u041E\u0412\u0415\u0414\u0415\u041D\u0418\u0415
    \u0412\u0420\u0410\u0413\u041E\u0412, \u0422\u0423\u041D\u041D\u0415\u041B\u0418)\u0418\u0417\u041C\u0415\u041D\u0418\u041B\u0418
    \u041F\u0420\u0415\u0414\u0421\u0422\u0410\u0412\u041B\u0415\u041D\u0418\u0415
    \u041E \u0422\u041E\u041C, \u041A\u0410\u041A\u0418\u041C\u0418 \u041C\u041E\u0413\u0423\u0422
    \u0411\u042B\u0422\u042C \u0418\u0413\u0420\u042B. \u041E\u041D\u0418 \u041F\u0415\u0420\u0415\u041A\u041E\u0427\u0415\u0412\u0410\u041B\u0418
    \u0412 \u041A\u0412\u0415\u0421\u0422\u042B, RPG, \u041E\u0422\u041A\u0420\u042B\u0422\u042B\u0415
    \u041C\u0418\u0420\u042B. \u0422\u042B \u041D\u0415 \u041F\u0420\u041E\u0421\u0422\u041E
    \u0418\u0413\u0420\u0410\u0415\u0428\u042C \u2014 \u0422\u042B \u0418\u0417\u0423\u0427\u0410\u0415\u0428\u042C
    \u0418\u0421\u0422\u041E\u0420\u0418\u042E."
  timedHints:
  - delayAfterStart: 10
    message: "\u0421\u0423\u041F\u0415\u0420-\u0422\u041E\u0427\u041A\u0418 \u0414\u0415\u041B\u0410\u042E\u0422
      \u041F\u0420\u0418\u0412\u0418\u0414\u0415\u041D\u0418\u0419 \u0423\u042F\u0417\u0412\u0418\u041C\u042B\u041C\u0418.
      \u0415\u0428\u042C \u0418\u0425 \u0412 \u042D\u0422\u041E\u041C \u0420\u0415\u0416\u0418\u041C\u0415
      \u2014 \u041F\u041E\u041B\u0423\u0427\u0418\u0428\u042C \u041C\u041D\u041E\u0413\u041E
      \u041E\u0427\u041A\u041E\u0412!"
    duration: 5
  - delayAfterStart: 20
    message: "\u0422\u0423\u041D\u041D\u0415\u041B\u0418 \u041F\u041E \u0411\u041E\u041A\u0410\u041C
      \u041B\u0410\u0411\u0418\u0420\u0418\u041D\u0422\u0410 \u041F\u041E\u041C\u041E\u0413\u0410\u042E\u0422
      \u0411\u042B\u0421\u0422\u0420\u041E \u0421\u041C\u0415\u041D\u0418\u0422\u042C
      \u041F\u041E\u0417\u0418\u0426\u0418\u042E, \u0415\u0421\u041B\u0418 \u041F\u0420\u0418\u0412\u0418\u0414\u0415\u041D\u0418\u042F
      \u0417\u0410\u0416\u0410\u041B\u0418 \u0412 \u0423\u0413\u041B\u0423"
    duration: 5
  - delayAfterStart: 30
    message: "\u0423 \u041A\u0410\u0416\u0414\u041E\u0413\u041E \u041F\u0420\u0418\u0412\u0418\u0414\u0415\u041D\u0418\u042F
      \u0421\u0412\u041E\u0401 \u041F\u041E\u0412\u0415\u0414\u0415\u041D\u0418\u0415.
      \u041D\u0410\u0411\u041B\u042E\u0414\u0410\u0419 \u2014 \u042D\u0422\u041E
      \u041F\u041E\u041C\u041E\u0416\u0415\u0422 \u0418\u0417\u0411\u0415\u0413\u0410\u0422\u042C
      \u0412\u0421\u0422\u0420\u0415\u0427"
    duration: 5
